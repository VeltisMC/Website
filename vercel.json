{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index"
    },
    {
      "source": "/downloads",
      "destination": "/index"
    },
    {
      "source": "/docs",
      "destination": "/index"
    },
    {
      "source": "/docs/introduction",
      "destination": "/index"
    },
    {
      "source": "/docs/prerequisites",
      "destination": "/index"
    },
    {
      "source": "/docs/downloading-and-first-boot",
      "destination": "/index"
    },
    {
      "source": "/docs/troubleshooting",
      "destination": "/index"
    },
    {
      "source": "/docs/startup-flags",
      "destination": "/index"
    },
    {
      "source": "/docs/performance-monitoring",
      "destination": "/index"
    },
    {
      "source": "/docs/overview",
      "destination": "/index"
    },
    {
      "source": "/docs/concurrency-model",
      "destination": "/index"
    },
    {
      "source": "/docs/migrating-from-paper",
      "destination": "/index"
    },
    {
      "source": "/developers",
      "destination": "/index"
    },
    {
      "source": "/community",
      "destination": "/index"
    },
    {
      "source": "/contributing",
      "destination": "/index"
    },
    {
      "source": "/changelog",
      "destination": "/index"
    },
    {
      "source": "/license",
      "destination": "/index"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/releases/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
